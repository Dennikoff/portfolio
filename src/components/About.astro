---
import FadeIn from "./FadeIn.astro";
import { useTranslations, type Lang } from "../i18n/utils";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const heading = lang === "ru" ? "обо мне" : "about";
---

<section
  id="about"
  aria-labelledby="about-heading"
  class="flex min-h-screen flex-col items-center justify-center px-5 py-20 sm:px-8 md:px-10"
>
  <FadeIn y={40}>
    <h2
      id="about-heading"
      class="hero-heading text-center font-black uppercase leading-none tracking-tight"
      style="font-size: clamp(3rem, 12vw, 160px)"
    >
      {heading}
    </h2>
  </FadeIn>

  {/* Абзац об опыте (в Фазе 4 — посимвольное проявление AnimatedText) */}
  <FadeIn delay={0.1} class="mt-10 w-full max-w-[560px] sm:mt-14 md:mt-16">
    <p
      class="text-center font-medium leading-relaxed text-ink"
      style="font-size: clamp(1rem, 2vw, 1.35rem)"
    >
      {t.expBody}
    </p>
  </FadeIn>

  {/* Две колонки: чип-группы навыков + таймлайн */}
  <FadeIn
    delay={0.15}
    class="mt-16 grid w-full max-w-5xl gap-14 sm:mt-20 md:mt-24 md:grid-cols-2"
  >
    <div class="flex flex-col gap-8">
      {
        t.skillGroups.map((g) => (
          <div>
            <p class="mb-3 font-mono text-xs font-medium uppercase tracking-widest text-aqua">
              {g.label}
            </p>
            <ul class="flex flex-wrap gap-2">
              {g.items.map((item) => (
                <li class="rounded-full border border-ink/25 px-3.5 py-1.5 text-sm text-ink">
                  {item}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <ul class="flex flex-col">
      {
        t.timeline.map((row, i) => (
          <li
            class:list={[
              "flex items-baseline gap-4 py-4",
              i > 0 && "border-t border-ink/15",
            ]}
          >
            <span class="shrink-0 font-mono text-sm font-medium text-aqua">
              {row.years}
            </span>
            <span class="text-ink-secondary">{row.what}</span>
          </li>
        ))
      }
    </ul>
  </FadeIn>
</section>
