---
import FadeIn from "./FadeIn.astro";
import AnimatedText from "./AnimatedText.astro";
import { useTranslations, type Lang } from "../i18n/utils";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const heading = lang === "ru" ? "обо мне" : "about";
---

<section
  id="about"
  aria-labelledby="about-heading"
  class="flex min-h-screen flex-col items-center justify-center px-5 py-20 sm:px-8 md:px-10"
>
  <FadeIn y={40}>
    <h2
      id="about-heading"
      class="hero-heading text-center font-black uppercase leading-none tracking-tight"
      style="font-size: clamp(3rem, 12vw, 160px)"
    >
      {heading}
    </h2>
  </FadeIn>

  {/* Абзац об опыте — посимвольное проявление по скроллу */}
  <div class="mt-10 w-full max-w-[560px] sm:mt-14 md:mt-16">
    <AnimatedText
      text={t.expBody}
      class="text-center font-medium leading-relaxed text-ink"
      style="font-size: clamp(1rem, 2vw, 1.35rem)"
    />
  </div>

  {/* Стек: группы чипов по центру, в одну колонку под текстом */}
  <FadeIn
    delay={0.15}
    class="mt-16 flex w-full max-w-2xl flex-col gap-8 sm:mt-20 md:mt-24"
  >
    {
      t.skillGroups.map((g) => (
        <div>
          <p class="mb-3 text-center font-mono text-xs font-medium uppercase tracking-widest text-aqua">
            {g.label}
          </p>
          <ul class="flex flex-wrap justify-center gap-2">
            {g.items.map((item) => (
              <li class="rounded-full border border-ink/25 px-3.5 py-1.5 text-sm text-ink">
                {item}
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </FadeIn>
</section>
