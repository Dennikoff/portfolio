---
import ContactButton from "./ContactButton.astro";
import FadeIn from "./FadeIn.astro";
import { useTranslations, email, socials, type Lang } from "../i18n/utils";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const year = 2026;
const rights = lang === "ru" ? "Все права защищены." : "All rights reserved.";
---

<footer
  id="contact"
  aria-labelledby="contact-heading"
  class="border-t border-ink/15 bg-bg px-5 py-20 sm:px-8 sm:py-24 md:px-10"
  style="content-visibility: auto; contain-intrinsic-size: auto 600px"
>
  <div class="mx-auto max-w-6xl">
    <FadeIn y={40}>
      <h2
        id="contact-heading"
        class="hero-heading font-black uppercase leading-none tracking-tight"
        style="font-size: clamp(2.5rem, 9vw, 120px)"
      >
        {t.contactTitle}
      </h2>
    </FadeIn>

    <FadeIn delay={0.1} class="mt-10 grid gap-10 md:grid-cols-[1.4fr_1fr] md:items-end">
      <div>
        <a
          href={`mailto:${email}`}
          class="font-mono font-medium text-orange transition-colors hover:underline"
          style="font-size: clamp(1rem, 2.4vw, 1.9rem)"
        >
          {email}
        </a>
        <div class="mt-8">
          <ContactButton href={`mailto:${email}`}>{t.ctaStart}</ContactButton>
        </div>
      </div>

      <ul class="flex flex-col gap-3 md:items-end">
        {
          socials.map((s) => (
            <li>
              <a
                href={s.url}
                target="_blank"
                rel="noopener"
                class="group inline-flex gap-2 transition-colors"
              >
                <span class="font-mono text-aqua group-hover:text-aqua-hover">
                  {s.label}
                </span>
                <span class="text-ink group-hover:text-aqua-hover">
                  / {s.handle}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </FadeIn>

    <p class="mt-16 text-[13px] text-ink-secondary">
      © {year} {t.name}. {rights}
    </p>
  </div>
</footer>
