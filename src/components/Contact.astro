---
import ContactButton from "./ContactButton.astro";
import FadeIn from "./FadeIn.astro";
import { useTranslations, email, telegram, socials, type Lang } from "../i18n/utils";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const year = 2026;
const rights = lang === "ru" ? "Все права защищены." : "All rights reserved.";

// Якоря абсолютные, а не «#work» — футер есть и на /privacy/, откуда
// внутристраничный хэш никуда бы не привёл.
const home = lang === "ru" ? "/" : "/en/";
const anchors = [
  { href: `${home}#work`, label: t.nav.work },
  { href: `${home}#pricing`, label: t.nav.pricing },
  { href: `${home}#about`, label: t.nav.about },
  { href: `${home}#contact`, label: t.nav.contact },
];
---

<footer
  id="contact"
  aria-labelledby="contact-heading"
  class="border-t border-ink/15 bg-bg px-5 py-20 sm:px-8 sm:py-24 md:px-10"
  style="content-visibility: auto; contain-intrinsic-size: auto 600px"
>
  <div class="mx-auto max-w-6xl">
    <FadeIn y={40}>
      <h2
        id="contact-heading"
        class="hero-heading font-black uppercase leading-none tracking-tight"
        style="font-size: clamp(2.5rem, 9vw, 120px)"
      >
        {t.contactTitle}
      </h2>
    </FadeIn>

    <FadeIn delay={0.1} class="mt-10 grid gap-10 md:grid-cols-[1.4fr_1fr] md:items-end">
      <div>
        <a
          href={`mailto:${email}`}
          class="font-mono font-medium text-orange transition-colors hover:underline"
          style="font-size: clamp(1rem, 2.4vw, 1.9rem)"
        >
          {email}
        </a>
        <div class="mt-8">
          <ContactButton href={telegram} target="_blank" rel="noopener">
            {t.ctaStart}
          </ContactButton>
        </div>
      </div>

      <ul class="flex flex-col gap-3 md:items-end">
        {
          socials.map((s) => (
            <li>
              <a
                href={s.url}
                target="_blank"
                rel="noopener"
                class="group inline-flex gap-2 transition-colors"
              >
                <span class="font-mono text-aqua group-hover:text-aqua-hover">
                  {s.label}
                </span>
                <span class="text-ink group-hover:text-aqua-hover">
                  / {s.handle}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </FadeIn>

    {/* Нижняя строка: якоря, политика и управление согласием на cookie. */}
    <div class="mt-16 border-t border-ink/15 pt-8">
      <div class="flex flex-col gap-6 md:flex-row md:items-start md:justify-between">
        <nav
          aria-label={t.footer.moreNav}
          class="flex flex-wrap gap-x-6 gap-y-2 text-[13px]"
        >
          {
            anchors.map((a) => (
              <a
                href={a.href}
                class="py-1.5 uppercase tracking-wider text-ink-secondary transition-colors hover:text-aqua-hover"
              >
                {a.label}
              </a>
            ))
          }
        </nav>

        <div class="flex flex-col gap-2 text-[13px] md:items-end">
          <a
            href={`${home}privacy/`}
            class="py-1.5 text-ink-secondary transition-colors hover:text-aqua-hover"
          >
            {t.footer.privacy}
          </a>
          <div class="flex flex-wrap items-center gap-x-5 gap-y-1">
            <button
              type="button"
              data-consent-open
              class="py-1.5 text-ink-secondary transition-colors hover:text-aqua-hover"
            >
              {t.footer.cookieSettings}
            </button>
            <button
              type="button"
              data-consent-reject
              class="py-1.5 text-ink-secondary transition-colors hover:text-aqua-hover"
            >
              {t.footer.cookieReject}
            </button>
          </div>
          {/* Текущее состояние согласия — заполняет cookie-consent.ts. */}
          <span
            data-consent-state
            data-label-on={t.footer.analyticsOn}
            data-label-off={t.footer.analyticsOff}
            class="font-mono text-[12px] text-ink-secondary/70"></span>
        </div>
      </div>

      <p class="mt-8 text-[13px] text-ink-secondary">
        © {year} {t.name}. {rights}
      </p>
    </div>
  </div>
</footer>
