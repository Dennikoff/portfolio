---
// Cookie-баннер. Логика — src/scripts/cookie-consent.ts.
// Рендерится с hidden: скрипт снимает атрибут только если решения ещё нет,
// поэтому у согласившихся баннер не мигает при загрузке.
import { useTranslations, type Lang } from "../i18n/utils";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const privacyHref = lang === "ru" ? "/privacy/" : "/en/privacy/";
---

<div
  data-cookie-banner
  class="cookie-banner"
  role="dialog"
  aria-modal="false"
  aria-labelledby="cookie-title"
  aria-describedby="cookie-body"
  aria-label={t.cookies.label}
  hidden
>
  <div class="flex items-start justify-between gap-4">
    <h2 id="cookie-title" class="text-base font-semibold text-ink">
      {t.cookies.title}
    </h2>

    {/* Крестик — тоже отказ, а не «просто закрыть»: он записывает решение. */}
    <button
      type="button"
      data-consent-dismiss
      class="cookie-x"
      aria-label={t.cookies.dismiss}
    >
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
        <path
          d="M6 6l12 12M18 6L6 18"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"></path>
      </svg>
    </button>
  </div>

  <p id="cookie-body" class="mt-3 text-[13px] leading-relaxed text-ink-secondary">
    {t.cookies.body}
  </p>

  <a href={privacyHref} class="cookie-link mt-2 inline-block text-[13px]">
    {t.cookies.more}
  </a>

  {/* Две равнозначные кнопки: отказ такого же размера, как согласие. Согласием
      считается только «Принять» — Esc и любое закрытие трактуются как отказ. */}
  <div class="mt-5 flex flex-wrap justify-end gap-3">
    <button type="button" data-consent-dismiss class="cookie-reject">
      {t.cookies.dismiss}
    </button>
    <button type="button" data-consent-accept class="cookie-accept">
      {t.cookies.accept}
    </button>
  </div>
</div>
