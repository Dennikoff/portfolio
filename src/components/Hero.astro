---
import Nav from "./Nav.astro";
import FadeIn from "./FadeIn.astro";
import Magnet from "./Magnet.astro";
import ContactButton from "./ContactButton.astro";
import GhostButton from "./GhostButton.astro";
import { useTranslations, telegram, type Lang } from "../i18n/utils";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
// Продающая фраза уезжает в tagline (решение §8): heroTitle1 + heroTitle2.
const tagline = `${t.heroTitle1} ${t.heroTitle2}`;
---

<section id="top" class="relative flex h-screen flex-col overflow-x-clip">
  <Nav lang={lang} />

  {/* H1 — вордмарк в два слоя. Слой A (серый, непрозрачный) — под фото (z-auto < фото z-10):
      голова его перекрывает. Слой B (тот же текст, opacity 0.4) — над фото (z-20).
      Идентичны и совмещены (absolute inset-0), поэтому вне головы читаются как одна плотная
      надпись, а за головой видно только полупрозрачный B. Контейнер без z-index/transform —
      чтобы z слоёв сравнивались с фото в общем контексте. */}
  <div class="relative flex-1 w-full">
    <div
      class="absolute inset-0 flex items-center overflow-hidden px-6 md:px-10"
    >
      <h1
        data-fit-text
        class="hero-heading w-full whitespace-nowrap font-black uppercase leading-none tracking-tight"
        style="font-size: 13vw"
      >
        denis kharke
      </h1>
    </div>
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 z-20 flex items-center overflow-hidden px-6 opacity-40 md:px-10"
    >
      <span
        data-fit-text
        class="hero-heading w-full whitespace-nowrap font-black uppercase leading-none tracking-tight"
        style="font-size: 13vw"
      >
        denis kharke
      </span>
    </div>
  </div>

  {/* Портрет по центру. Центрирующий transform — на внешней обёртке, fade — на внутренней. */}
  <div
    class="absolute left-1/2 z-10 top-1/2 -translate-x-1/2 -translate-y-1/2 sm:top-auto sm:bottom-0 sm:translate-y-0 w-[280px] sm:w-[360px] md:w-[440px] lg:w-[520px]"
  >
    <FadeIn delay={0.6} y={30}>
      <Magnet padding={150} strength={3} class="w-full">
        <img
          src="/myPhoto.webp"
          alt={lang === "ru" ? "Денис Харке" : "Denis Kharke"}
          width="1024"
          height="1536"
          fetchpriority="high"
          class="w-full max-h-[calc(100vh-6rem)] rounded-xl object-contain object-bottom"
        />
      </Magnet>
    </FadeIn>
  </div>

  {/* Нижняя полоса: tagline + CTA — всегда на экране, без fade-анимации. */}
  <div
    class="relative z-20 flex flex-col items-start gap-6 px-6 pb-7 sm:flex-row sm:items-end sm:justify-between md:px-10 sm:pb-8 md:pb-10"
  >
    <p
      class="max-w-[420px] font-light uppercase tracking-wide leading-snug text-ink"
      style="font-size: clamp(0.9rem, 1.6vw, 1.6rem)"
    >
      {tagline}
    </p>
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
      <ContactButton href={telegram} target="_blank" rel="noopener">
        {t.ctaStart}
      </ContactButton>
      <GhostButton href="#work">{t.ctaWork}</GhostButton>
    </div>
  </div>
</section>
