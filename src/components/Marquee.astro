---
import Placeholder from "./Placeholder.astro";
import { projLinks, type Lang } from "../i18n/utils";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const shot = lang === "ru" ? "скриншот" : "screenshot";

// Две ленты; массив каждой утроен для бесшовности (marquee.ts двигает по скроллу).
const rows = [
  { tiles: [...projLinks], dir: "right" },
  { tiles: [...projLinks].reverse(), dir: "left" },
];
---

<section
  data-marquee
  class="bg-bg pt-24 sm:pt-32 md:pt-40 pb-10 overflow-x-clip"
  aria-hidden="true"
  style="content-visibility: auto"
>
  {
    rows.map((row) => (
      <div
        data-marquee-row
        data-marquee-dir={row.dir}
        class="flex gap-3 mb-3 last:mb-0 w-max will-change-transform"
      >
        {[...row.tiles, ...row.tiles, ...row.tiles].map((p) => (
          <Placeholder
            label={`${shot}: ${p.host}`}
            ratio="420 / 270"
            class="w-[420px] shrink-0 rounded-2xl"
          />
        ))}
      </div>
    ))
  }
</section>
