---
import LangSwitch from "./LangSwitch.astro";
import { useTranslations, type Lang } from "../i18n/utils";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const links = [
  { href: "#work", label: t.nav.work },
  { href: "#pricing", label: t.nav.pricing },
  { href: "#about", label: t.nav.about },
  { href: "#contact", label: lang === "ru" ? "Контакт" : "Contact" },
];
---

<nav
  data-nav
  class="nav-in fixed inset-x-0 top-0 z-50"
  aria-label={lang === "ru" ? "Основная навигация" : "Primary"}
>
  <div
    data-nav-bar
    class="flex items-center justify-between border-b border-ink/10 bg-bg/70 px-6 py-4 backdrop-blur-md md:px-10 md:py-5"
  >
    <a href="#top" class="font-mono font-medium text-ink text-base md:text-lg">
      Denis Kharke
    </a>

    <div class="flex items-center gap-3 sm:gap-4 md:gap-7">
      <ul class="hidden sm:flex items-center gap-4 md:gap-7">
        {
          links.map((l) => (
            <li>
              <a
                href={l.href}
                class="text-ink font-medium uppercase tracking-wider text-sm md:text-lg lg:text-[1.4rem] transition-opacity hover:opacity-70"
              >
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>

      <LangSwitch lang={lang} />

      <button
        type="button"
        data-nav-toggle
        class="burger relative h-11 w-11 text-ink sm:hidden"
        aria-label={lang === "ru" ? "Меню" : "Menu"}
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>

  {/* Мобильная панель — раскрывается под строкой навбара (sm:hidden скрывает на десктопе) */}
  <div
    id="mobile-menu"
    data-nav-menu
    class="hidden border-t border-ink/10 bg-bg px-6 pb-4 sm:hidden"
  >
    <ul class="flex flex-col">
      {
        links.map((l) => (
          <li>
            <a
              href={l.href}
              class="block border-b border-ink/10 py-4 text-lg font-medium uppercase tracking-wider text-ink transition-colors last:border-0 hover:text-aqua-hover"
            >
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</nav>

<script>
  // Плавающая «liquid glass» шапка: при скролле вниз вешаем data-scrolled (морфинг — в CSS).
  const nav = document.querySelector<HTMLElement>("[data-nav]");
  if (nav) {
    const onScroll = () => {
      nav.dataset.scrolled = window.scrollY > 24 ? "true" : "false";
    };
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
  }

  const toggle = document.querySelector<HTMLButtonElement>("[data-nav-toggle]");
  const menu = document.querySelector<HTMLElement>("[data-nav-menu]");
  if (toggle && menu) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute("aria-expanded", String(open));
      menu.classList.toggle("hidden", !open);
    };
    toggle.addEventListener("click", () =>
      setOpen(toggle.getAttribute("aria-expanded") !== "true"),
    );
    menu
      .querySelectorAll("a")
      .forEach((a) => a.addEventListener("click", () => setOpen(false)));
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") setOpen(false);
    });
  }
</script>
