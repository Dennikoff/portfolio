---
import NumberedItem from "./NumberedItem.astro";
import FadeIn from "./FadeIn.astro";
import { useTranslations, type Lang } from "../i18n/utils";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const heading = t.processTitle;
---

<section
  aria-labelledby="process-heading"
  class="bg-bg px-5 py-20 sm:px-8 sm:py-24 md:px-10 md:py-32"
  style="content-visibility: auto; contain-intrinsic-size: auto 800px"
>
  <FadeIn>
    <h2
      id="process-heading"
      class="mb-12 text-center font-black uppercase leading-none tracking-tight hero-heading sm:mb-16 md:mb-20"
      style="font-size: clamp(3rem, 12vw, 160px)"
    >
      {heading}
    </h2>
  </FadeIn>

  <div class="mx-auto max-w-5xl">
    {
      t.steps.map((step, i) => (
        <FadeIn delay={i * 0.1}>
          <NumberedItem
            n={String(i + 1).padStart(2, "0")}
            name={step.name}
            desc={step.desc}
            accent={i === 0}
            divider={i < t.steps.length - 1}
          />
        </FadeIn>
      ))
    }
  </div>
</section>
