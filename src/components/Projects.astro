---
import GhostButton from "./GhostButton.astro";
import FadeIn from "./FadeIn.astro";
import { useTranslations, projLinks, type Lang } from "../i18n/utils";
import { asset } from "../lib/assets";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const heading = lang === "ru" ? "работы" : "work";

// Зип локализованных мета-данных с общими ссылками по индексу.
const projects = t.projMeta.map((m, i) => ({ ...m, ...projLinks[i] }));
---

<section
  id="work"
  aria-labelledby="work-heading"
  class="-mt-10 rounded-t-[40px] bg-bg px-5 py-20 sm:-mt-12 sm:rounded-t-[50px] sm:px-8 md:-mt-14 md:rounded-t-[60px] md:px-10 md:pt-24 md:pb-32"
>
  <FadeIn>
    <h2
      id="work-heading"
      class="mb-12 text-center font-black uppercase leading-none tracking-tight hero-heading sm:mb-16 md:mb-20"
      style="font-size: clamp(3rem, 12vw, 160px)"
    >
      {heading}
    </h2>
  </FadeIn>

  {/* Sticky-дек: на md+ обёртка на весь экран липнет к top-0 с отступом сверху (pt),
      каждая карточка смещена на i*2rem ниже → видно наложение стопкой; stack.ts масштабирует.
      На мобиле — обычный поток. */}
  <div class="mx-auto max-w-6xl">
    {
      projects.map((p, i) => {
        // Скрины проекта (по 3). Раскладка §4.5 ТЗ: shots[0] — большой справа,
        // shots[1]/[2] — стопка слева. pos — object-position (по умолчанию top).
        // m есть не у всех скринов — мобильный ряд показывает только те, у кого он есть.
        const imgs = p.shots as readonly {
          d: string;
          m?: string;
          mobW?: number;
          mobH?: number;
          pos?: string;
        }[];
        const big = imgs[0];
        const side = imgs.slice(1);
        const mobShots = imgs.filter((s) => s.m);
        return (
        <div
          data-stack-item
          class="mb-8 last:mb-0 md:mb-0 md:flex md:h-screen md:items-start md:justify-center md:sticky md:top-0 md:pt-[100px]"
        >
        <FadeIn class="w-full">
        <article
          data-stack-card
          class="w-full rounded-[40px] border-2 border-ink bg-bg p-4 sm:rounded-[50px] sm:p-6 md:relative md:flex md:h-[calc(100vh-180px)] md:flex-col md:overflow-hidden md:rounded-[60px] md:p-8"
          style={`top: calc(${i} * 1.1rem); transform-origin: top;`}
        >
          <div class="flex flex-wrap items-center gap-x-5 gap-y-2">
            <span
              class="font-black leading-none text-ink"
              style="font-size: clamp(2.5rem, 7vw, 90px)"
              aria-hidden="true"
            >
              {String(i + 1).padStart(2, "0")}
            </span>
            <span class="rounded-full border border-aqua/40 px-3 py-1 font-mono text-xs uppercase text-aqua">
              {p.tag}
            </span>
            <h3
              class="font-medium uppercase text-ink"
              style="font-size: clamp(1rem, 2.2vw, 2.1rem)"
            >
              {p.name}
            </h3>
            <span class="font-mono text-sm text-aqua">{p.host}</span>
            <GhostButton
              href={p.url}
              target="_blank"
              rel="noopener"
              class="ml-auto !px-6 !py-2.5 !text-sm"
            >
              {t.openSite} ↗
            </GhostButton>
          </div>

          <p class="mt-4 max-w-2xl text-ink-secondary">{p.desc}</p>

          <div class="mt-6 md:mt-5 md:min-h-0 md:flex-1">
            {/* md+: слева колонка (2fr), справа большой (3fr) — как в §4.5 ТЗ.
                Все ячейки тянутся на высоту карточки → верх и низ совпадают. */}
            <div class="hidden h-full md:grid md:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] md:gap-3">
              <div class="grid h-full min-h-0 grid-rows-2 gap-3">
                {side.slice(0, 2).map((sh) => (
                  <div class="min-h-0 overflow-hidden rounded-2xl">
                    <img
                      src={asset(sh.d).src}
                      alt={`${p.name} — ${p.host}`}
                      width={asset(sh.d).width}
                      height={asset(sh.d).height}
                      loading="lazy"
                      class:list={[
                        "h-full w-full object-cover",
                        sh.pos === "bottom" ? "object-bottom" : "object-top",
                      ]}
                    />
                  </div>
                ))}
              </div>
              <div class="min-h-0 overflow-hidden rounded-2xl">
                <img
                  src={asset(big.d).src}
                  alt={`${p.name} — ${p.host}`}
                  width={asset(big.d).width}
                  height={asset(big.d).height}
                  loading="lazy"
                  class:list={[
                    "h-full w-full object-cover",
                    big.pos === "bottom" ? "object-bottom" : "object-top",
                  ]}
                />
              </div>
            </div>

            {/* mobile: портретные мобильные скрины в ряд (только те, у кого есть m). */}
            <div class="flex gap-2 md:hidden">
              {mobShots.map((sh) => (
                <div class="aspect-[1/2] min-w-0 flex-1 overflow-hidden rounded-2xl">
                  <img
                    src={asset(sh.m!).src}
                    alt={`${p.name} — ${p.host}`}
                    width={asset(sh.m!).width}
                    height={asset(sh.m!).height}
                    loading="lazy"
                    class="h-full w-full object-cover object-top"
                  />
                </div>
              ))}
            </div>
          </div>
        </article>
        </FadeIn>
        </div>
        );
      })
    }
  </div>
</section>
