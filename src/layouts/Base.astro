---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  lang?: "ru" | "en";
}

const {
  title,
  description = "Denis Kharke — фронтенд-разработчик: лендинги, сайты и веб-приложения.",
  lang = "ru",
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" hreflang="ru" href={new URL("/", Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL("/en/", Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL("/", Astro.site)} />
    <title>{title}</title>
  </head>
  <body>
    <div class="root" style="overflow-x: clip;">
      <slot />
    </div>
    <script>
      import "../scripts/fade.ts";
    </script>
  </body>
</html>
